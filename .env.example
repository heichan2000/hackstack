# Copy to .env and fill in what you use. Secrets only: non-secret settings live in hackstack.yaml.
# Any hackstack.yaml value can also be overridden here as HACKSTACK_<SECTION>__<KEY>=...

# --- profile ---------------------------------------------------------------------------------
# default = Claude + Voyage (needs the two keys below); local = Ollama, no paid APIs
HACKSTACK_PROFILE=default

# --- model APIs ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Only for OpenAI-compatible endpoints that need a key (OpenAI, Groq, OpenRouter); Ollama does not
OPENAI_API_KEY=

# --- connectors ------------------------------------------------------------------------------
# GitHub fine-grained PAT, read-only (Contents, Issues, Pull requests, Metadata)
GITHUB_TOKEN=
# Notion internal integration secret; share each page with the integration
NOTION_TOKEN=
# Slack internal app bot token (xoxb-...); invite the bot to each channel
SLACK_BOT_TOKEN=
# Google "Desktop app" OAuth client JSON (Drive + Gmail, read-only) and where to cache the token
GOOGLE_CLIENT_SECRETS_FILE=
GOOGLE_TOKEN_FILE=.secrets/google_token.json

# --- runtime ---------------------------------------------------------------------------------
# Postgres host port for docker compose. The default, 5433, avoids a natively installed Postgres
# on 5432. If you change it, change the DSN to match:
# HACKSTACK_PG_PORT=5433
# HACKSTACK_STORE__DSN=postgresql://hackstack:hackstack@localhost:5433/hackstack
# Who the MCP server and `hackstack ask` act as, for permission-aware search
# HACKSTACK_AS_USER=you@company.test
# Put prompt/response text on trace spans. Local only: spans would carry PII
# HACKSTACK_TRACING__CAPTURE_CONTENT=false
